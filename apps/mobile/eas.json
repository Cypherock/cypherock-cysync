{
  "cli": {
    "version": ">= 14.4.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "production": {
      "node": "18.18.0",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal"
    },
    "development": {
      "extends": "production",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6743165054"
      }
    }
  }
}
