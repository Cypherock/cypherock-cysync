-  return TX_OUTPUT_BASE + (output.script ? output.script.length : TX_OUTPUT_PUBKEYHASH)
+  var type = output.address ? classifyAddress(output.address) : 'UNKNOWN';
+  return OUTPUT_SIZES[type];
 }
 
