+// Size of scriptSig/witness for different input types
+var INPUT_SIZES = {
+  P2PKH: 148,
+  P2SH: 91,
+  P2WPKH: 68,
+  P2WSH: 104,  // base tx size for wrapped segwit input
+  P2TR: 58,
+  UNKNOWN: 148,
+};
+
+// Size of scriptPubKey for outputs
+var OUTPUT_SIZES = {
+  P2PKH: 34,
+  P2SH: 32,
+  P2WPKH: 31,
+  P2WSH: 43,
+  P2TR: 43,
+  UNKNOWN: 43,
+};
+
+function classifyAddress(address) {
+  // Bitcoin (BTC)
+  if (address.startsWith('1')) return 'P2PKH';
+  if (address.startsWith('3')) return 'P2SH';
+  if (address.startsWith('bc1q')) return 'P2WPKH';
+  if (address.startsWith('bc1p')) return 'P2TR';
+
+  // Litecoin (LTC)
+  if (address.startsWith('L')) return 'P2PKH';
+  if (address.startsWith('3') || address.startsWith('M')) return 'P2SH';
+  if (address.startsWith('ltc1q')) return 'P2WPKH';
+  if (address.startsWith('ltc1p')) return 'P2WSH';
+
+  // Dogecoin (DOGE)
+  if (address.startsWith('D')) return 'P2PKH';
+  if (address.startsWith('9')) return 'P2SH';
+  if (address.startsWith('doge1')) return 'P2WPKH';     // Bech32 (rare but some wallets support it)
+
+  // Dash (DASH)
+  if (address.startsWith('X')) return 'P2PKH';
+  if (address.startsWith('7')) return 'P2SH';
+  if (address.startsWith('dash1')) return 'P2WPKH';     // Dash Bech32 address prefix
+
+  // Dash testnet
+  if (address.startsWith('y')) return 'P2PKH';
+  if (address.startsWith('8')) return 'P2SH';
+
+  return 'UNKNOWN';
+}
+
 function inputBytes (input) {
-  return TX_INPUT_BASE + (input.script ? input.script.length : TX_INPUT_PUBKEYHASH)
